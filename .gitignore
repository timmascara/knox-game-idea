node_modules/
dist/
screenshots/
*.log
.DS_Store
.vite/
_*.mjs

# assets_raw holds the raw download: the mesh, its .mtl and the texture
# archive. Everything else in there — extracted textures, format conversions,
# the interim glTF — is regenerated by `npm run assets` and must not be
# committed, or the repo carries every texture twice.
assets_raw/**/*.jpg
assets_raw/**/*.jpeg
assets_raw/**/*.png
assets_raw/**/*.tif
assets_raw/**/*.tiff
assets_raw/**/*.tga
assets_raw/**/__interim.*
.artifact/
